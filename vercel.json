{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "react-router build",
  "outputDirectory": "build/client",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
